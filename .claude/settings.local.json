{
  "permissions": {
    "allow": [
      "Bash(dir:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew.bat build)",
      "Bash(./gradlew.bat --stop)",
      "Bash(./gradlew.bat clean build)",
      "Bash(ls:*)",
      "Bash(./gradlew clean build:*)",
      "Bash(./gradlew run:*)",
      "Bash(taskkill:*)",
      "Bash(exit 0)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(tail -n *:*)",
      "Bash(head -n *:*)",
      "Bash(cat build/*:*)",
      "Bash(cat src/*:*)",
      "Bash(ls build/*:*)",
      "Bash(ls src/*:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)"
    ]
  }
}